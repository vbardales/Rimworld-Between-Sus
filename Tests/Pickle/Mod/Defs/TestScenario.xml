<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Development only: same scenario as BS_BetweenSus with the roles forced, so kills, sabotage, abilities and votes can be scripted.
	     Colonists sorted by name take the roles in order; the first one is the main pawn. -->
	<ScenarioDef ParentName="ScenarioBase">
		<defName>BS_BetweenSus_Test</defName>
		<label>Between Sus (test)</label>
		<description>Test scenario with forced roles. Never published.</description>
		<scenario>
			<summary>Between Sus with forced roles.</summary>
			<parts>
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnCount>8</pawnCount>
					<pawnChoiceCount>10</pawnChoiceCount>
				</li>
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>Standing</method>
					<visible>false</visible>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MealSurvivalPack</thingDef>
					<count>40</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MedicineIndustrial</thingDef>
					<count>20</count>
				</li>
				<li Class="BetweenSus.ScenPart_AssignRoles">
					<def>BS_AssignRoles</def>
					<impostorCount>2</impostorCount>
					<forcedMainIndex>0</forcedMainIndex>
					<forcedRoles>
						<li>BS_Impostor_Impostor</li>
						<li>BS_Impostor_Ninja</li>
						<li>BS_Crewmate_Innocent</li>
						<li>BS_Crewmate_Engineer</li>
						<li>BS_Crewmate_Scientist</li>
						<li>BS_Crewmate_Tracker</li>
						<li>BS_Crewmate_Necromancer</li>
						<li>BS_Crewmate_Innocent</li>
					</forcedRoles>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>

